prob
	(not "Read !16")* . "Read !16" .
	loop (time, chain_counter, tmp: Nat := 0) : (res: Nat) in
		if (chain_counter = 0) then
			  ({Time ?tx:Nat}).continue(time + tx, chain_counter, tmp)
			| ({Read ?st:Nat}).continue(time, chain_counter, tmp + st)
			| ("Start").continue(time, chain_counter + 1, tmp)
			| ("Finish").continue(time, chain_counter, tmp)
			| ("Write").continue(time, chain_counter, tmp)
		elsif (chain_counter = 1) then
			  ({Time ?tx:Nat}).continue(time + tx, chain_counter, tmp)
			| ({Read ?st:Nat}).continue(time, chain_counter, tmp + st)
			| ("Start").continue(time, chain_counter, tmp)
			| ("Finish").continue(time, chain_counter + 1, tmp)
			| ("Write").continue(time, chain_counter, tmp)
		elsif (chain_counter = 2) then
			  ({Time ?tx:Nat}).continue(time + tx, chain_counter, tmp)
			| ({Read ?st:Nat}).continue(time, chain_counter, tmp + st)
			| ("Start").continue(time, chain_counter, tmp)
			| ("Finish").continue(time, chain_counter, tmp)
			| ("Write").continue(time, chain_counter + 1, tmp)
		else exit (time)
		end if
	end loop .
	if (res <> 14) then false end if
is >= ? 0
end prob