system services;
process Actuator(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        when x = 4;
            set x:= 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 2;
            informal "Write"; 
            nextstate wait;
    endstate;
    state wait;
        when x = 10;
            set x:= 0;
            nextstate jitter;
    endstate;
endprocess;
endsystem;


