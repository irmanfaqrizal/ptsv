system simpler;
process A(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate wait;
    endstate;
    state wait;
        when x = 1;
            set x:= 0;
            nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 1;
            informal "A";
            nextstate start;
    endstate;
endprocess;
process B(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate wait;
    endstate;
    state wait;
        when x = 3;
            nextstate first;
    endstate;
    state first;
        informal "B";
        nextstate start;
    endstate;
endprocess;
endsystem;