system single; [strong]
process A(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 2;
            informal "A"; [custom:1/3,1/3,1/3]
            reset x;
            stop;
    endstate;
endprocess;
process B(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 2;
            informal "B"; [custom:1/3,1/3,1/3]
            reset x;
            stop;
    endstate;
endprocess;
endsystem;