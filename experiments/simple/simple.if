system simple; [strong]
process A(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 1;
            informal "A"; [custom:1/4,3/4]
            nextstate wait;
    endstate;
    state wait;
        when x = 2;
            set x:= 0;
            nextstate jitter;
    endstate;
endprocess;
process B(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 3;
            informal "B"; [custom:1/8,1/2,1/8,1/4]
            nextstate wait;
    endstate;
    state wait;
        when x = 4;
            set x:= 0;
            nextstate jitter;
    endstate;
endprocess;
endsystem;