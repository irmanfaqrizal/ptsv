system aebs;
process Controller(1);
    var x clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        when x = 10;
            informal "Start";
            set x:= 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when x >= 1 and x <= 3;
            informal "Finish";
            nextstate wait;
    endstate;
    state wait;
        when x = 5;
            informal "Start";
            set x:= 0;
            nextstate exec;
    endstate;
endprocess;
endsystem;
